# Copy to .env (gitignored) and fill in. Nothing here is read until the publish / deploy steps.

# Cloudflare R2 (S3-compatible). Dashboard: R2 > Manage API tokens (Object Read & Write on the bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=livability-tiles
# Public base URL of the bucket: a custom domain (recommended; r2.dev is rate-limited)
R2_PUBLIC_BASE_URL=https://tiles.example.org
# Comma-separated origins allowed to read tiles from the browser (Pages URL, custom domain, local dev)
R2_ALLOWED_ORIGINS=https://livability-map.pages.dev,http://localhost:3000

# Cloudflare Pages deploy (account API token with "Cloudflare Pages: Edit"; account id from the dashboard URL)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CF_PAGES_PROJECT=livability-map
# Where the web build reads hexes.pmtiles + manifest.json in production (same value as R2_PUBLIC_BASE_URL)
NEXT_PUBLIC_DATA_BASE=

# Harvard Dataverse guestbook for the MIT Election Lab county returns (SPEC §13.26).
# Optional: leave empty and download countypres_2000-2024.csv by hand into data/raw/medsl_county_pres/.
DATAVERSE_GUESTBOOK_NAME=
DATAVERSE_GUESTBOOK_EMAIL=
DATAVERSE_GUESTBOOK_INSTITUTION=
DATAVERSE_GUESTBOOK_POSITION=
